{
  "name": "@totra/ts-oop",
  "version": "1.0.0",
  "description": "CQRS / Authorization / FeatureFlag / Event-Driven / DDD / Observable framework for typescript. Innovate and rewrite fearlessly. Keep your core logic intact.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": [
      "./dist/index.js"
    ],
    "./*": [
      "./dist/*.js"
    ]
  },
