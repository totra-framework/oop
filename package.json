    "prepublish": "rm -rf dist && tsc",
    "release": "npm run prepublish && npm publish",
    "test": "vitest"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "directories": {
    "example": "examples"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.0.0"
  }
}
